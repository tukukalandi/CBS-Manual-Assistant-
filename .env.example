# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# For Vercel deployments, configure GEMINI_API_KEY in Project Settings > Environment Variables.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Optional model configuration (defaults to gemini-3.1-flash-lite with gemini-4-hydrogen fallback)
GEMINI_PRIMARY_MODEL="gemini-3.1-flash-lite"
GEMINI_FALLBACK_MODEL="gemini-4-hydrogen"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
